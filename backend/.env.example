DB_HOST=localhost
DB_PORT=3306
DB_NAME=OTT_Content_Management

# normal account: browse, watch, profile
DB_USER=ott_user
DB_PASSWORD=password_of_ott_user

# admin account: used only by the /admin routes
ADMIN_DB_USER=ott_admin
ADMIN_DB_PASSWORD=password_of_ott_admin

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRE_HOURS=12
